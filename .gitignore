# Ignore everything by default
*

# Allow Python source code
!/*.py

# Allow processed datasets
!data/
!data/processed/
!data/processed/*.csv

# Allow trained LSTM model
!models/
!models/lstm.pt

# Allow training history
!metrics/
!metrics/lstm_training_history.csv

# Allow validation results
!metrics/lstm_validation/
!metrics/lstm_validation/*.csv

# Allow test results
!metrics/lstm_test/
!metrics/lstm_test/*.csv

# Allow documentation
!*.md
!docs/
!docs/results/
!docs/results/five_zone_case_study.png
!docs/results/actual_vs_predicted.png

# Allow dependencies
!requirements.txt

# Allow GitHub Actions workflows
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Keep the .gitignore itself
!.gitignore

# Ignore Python temporary files
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Ignore virtual environments
.venv/
venv/

# Ignore raw datasets
data/occupancy.csv

# Ignore unused training plot
docs/results/training_history.png

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
